# frozen_string_literal: true

source "https://rubygems.org"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "~> 8.0.3"

# Database
gem "pg", ">= 1.5" # PostgreSQL adapter
gem "sqlite3", ">= 1.4" # SQLite adapter

# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 5.0"

# Build JSON APIs with ease [https://github.com/rails/jbuilder]
gem "jbuilder"

# Authentication & Authorization
gem "bcrypt", "~> 3.1.7" # Use Active Model has_secure_password
gem "devise" # Authentication
gem "jwt" # JSON Web Token
gem "omniauth" # OAuth authentication
gem "omniauth-github" # GitHub OAuth
gem "omniauth-google-oauth2" # Google OAuth
gem "omniauth-rails_csrf_protection" # CSRF protection for OmniAuth
gem "pundit" # Authorization

# API & CORS
gem "rack-attack" # Rate limiting and throttling
gem "rack-cors" # Cross-Origin Resource Sharing

# External APIs
gem "faraday" # HTTP client
gem "faraday-retry" # Retry middleware for Faraday
gem "httparty" # HTTP requests
gem "octokit" # GitHub API
gem "stripe" # Stripe payment processing

# Background Jobs
gem "sidekiq" # Background job processing
gem "sidekiq-cron" # Cron jobs for Sidekiq

# Caching & Session
gem "redis", "~> 5.0" # Redis for caching and sessions

# Monitoring & Error Tracking
gem "sentry-rails"
gem "sentry-ruby"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: [:windows, :jruby]

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# Deploy this application anywhere as a Docker container [https://kamal-deploy.org]
gem "kamal", require: false

# Add HTTP asset caching/compression and X-Sendfile acceleration to Puma [https://github.com/basecamp/thruster/]
gem "thruster", require: false

group :development, :test do
  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: [:mri, :windows], require: "debug/prelude"

  # Testing framework
  gem "factory_bot_rails" # Test data factories
  gem "faker" # Fake data generation
  gem "rspec-rails" # RSpec testing framework
  gem "shoulda-matchers", "~> 5.0" # RSpec matchers for validations/associations

  # Static analysis for security vulnerabilities [https://brakemanscanner.org/]
  gem "brakeman", require: false

  # Omakase Ruby styling [https://github.com/rails/rubocop-rails-omakase/]
  gem "rubocop-rails-omakase", require: false

  # Additional RuboCop extensions
  gem "rubocop-performance", require: false
  gem "rubocop-rspec", require: false
end

group :development do
  # Development tools
  gem "annotate" # Model annotation
  gem "bullet" # N+1 query detection
  gem "dotenv-rails" # Environment variables
  gem "letter_opener" # Preview email in the browser
  gem "letter_opener_web" # Web interface for letter_opener
  gem "listen", "~> 3.3" # File change listener
  gem "pry-rails" # Better console
  gem "spring" # Application preloader
end
