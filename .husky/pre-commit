#!/usr/bin/env sh
set -e

# Frontend: lint-staged
if [ -f "dev_catalyst_front/package.json" ]; then
  (
    cd dev_catalyst_front
    npx --yes lint-staged
  )
fi

# Rails: RuboCop
if [ -f "dev_catalyst_rails/Gemfile" ]; then
  STAGED_RB_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^dev_catalyst_rails/.*\.rb$' || true)
  if [ -n "$STAGED_RB_FILES" ]; then
    (
      cd dev_catalyst_rails
      bundle exec rubocop -A --force-exclusion -- $STAGED_RB_FILES
    )
    echo "$STAGED_RB_FILES" | xargs git add
  fi
fi


