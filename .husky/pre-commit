#!/usr/bin/env sh
set -e

# Frontend: lint-staged
if [ -f "dev_catalyst_front/package.json" ]; then
  (
    cd dev_catalyst_front
    npx --yes lint-staged
    # 追加: プロジェクト全体の軽微なLint修正（必要に応じて）
    if npm run -s >/dev/null 2>&1; then
      echo "Running npm run lint:fix..."
      npm run -s lint:fix || true
    fi
  )
fi

# FastAPI (Python): Black / isort をステージ済み .py に適用
if [ -d "dev_catalyst_fastapi" ]; then
  STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^dev_catalyst_fastapi/.*\.py$' || true)
  if [ -n "$STAGED_PY_FILES" ]; then
    (
      cd dev_catalyst_fastapi
      if command -v black >/dev/null 2>&1; then
        echo "Running black on staged Python files..."
        echo "$STAGED_PY_FILES" | xargs black --quiet
      else
        echo "black not found; skip formatting staged Python files."
      fi
      if command -v isort >/dev/null 2>&1; then
        echo "Running isort on staged Python files..."
        echo "$STAGED_PY_FILES" | xargs isort --quiet
      else
        echo "isort not found; skip import sort on staged Python files."
      fi
    )
    echo "$STAGED_PY_FILES" | xargs git add
  fi
fi

# Rails: RuboCop
if [ -f "dev_catalyst_rails/Gemfile" ]; then
  STAGED_RB_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^dev_catalyst_rails/.*\.rb$' || true)
  if [ -n "$STAGED_RB_FILES" ]; then
    (
      cd dev_catalyst_rails
      # まず安全な自動修正 (-a) を実行
      bundle exec rubocop -a --force-exclusion -- $STAGED_RB_FILES || true
      # 追加の修正が必要な場合は、強力な自動修正 (-A) を最後の手段として適用（任意）
      # bundle exec rubocop -A --force-exclusion -- $STAGED_RB_FILES || true
    )
    echo "$STAGED_RB_FILES" | xargs git add
  fi
fi


